<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Proper SSH Manager" Width="1320" Height="840" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#080F19" Foreground="#E7EEF8" FontFamily="Segoe UI" FontSize="12">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Border Background="#0C1929" BorderBrush="#22354A" BorderThickness="0,0,0,1" Padding="22,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#0969EF" CornerRadius="7" Width="40" Height="40"><TextBlock Text="›_" FontFamily="Consolas" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="Proper SSH Manager" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="SSH, RDP, transfer file, dan editor remote dalam satu workspace" FontSize="11" Foreground="#91A5BF" Margin="0,3,0,0"/></StackPanel></StackPanel>
   <Grid Grid.Column="1"><Menu x:Name="MainMenu" VerticalAlignment="Center" HorizontalAlignment="Right">
            <MenuItem Header="_File">
                <MenuItem x:Name="MenuImport" Header="Import konfigurasi..."/>
                <MenuItem x:Name="MenuExport" Header="Export konfigurasi..."/>
                <Separator/>
                <MenuItem x:Name="MenuExit" Header="Keluar" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Host">
                <MenuItem x:Name="MenuAddHost" Header="Tambah host" InputGestureText="Ctrl+N"/>
                <MenuItem x:Name="MenuEditHost" Header="Edit host" InputGestureText="Ctrl+E"/>
                <MenuItem x:Name="MenuDuplicateHost" Header="Duplikat host" InputGestureText="Ctrl+D"/>
                <MenuItem x:Name="MenuDeleteHost" Header="Hapus host" InputGestureText="Delete"/>
                <Separator/>
                <MenuItem x:Name="MenuScp" Header="Transfer SCP..." InputGestureText="Ctrl+Shift+S"/>
                <MenuItem x:Name="MenuEditFile" Header="Edit file remote..." InputGestureText="Ctrl+Shift+E"/>
                <MenuItem x:Name="MenuRdpManager" Header="RDP Manager..." InputGestureText="Ctrl+Shift+R"/>
            </MenuItem>
            <MenuItem Header="_VPN">
                <MenuItem x:Name="MenuVpnProfiles" Header="Kelola profil VPN..."/>
                <MenuItem x:Name="MenuDisconnectVpn" Header="Putuskan VPN terpilih"/>
            </MenuItem>
            <MenuItem Header="_Konfigurasi">
                <MenuItem x:Name="MenuSettings" Header="Pengaturan aplikasi..."/>
                <MenuItem x:Name="MenuDependencies" Header="Periksa dependensi..."/>
                <MenuItem x:Name="MenuOpenData" Header="Buka folder data"/>
            </MenuItem>
            <MenuItem Header="_Bantuan">
                <MenuItem x:Name="MenuShortcuts" Header="Daftar shortcut"/>
                <MenuItem x:Name="MenuAbout" Header="Tentang"/>
            </MenuItem>
        </Menu></Grid>
  </Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ContentControl x:Name="SidebarHost"/>
   <Grid Grid.Column="1" Margin="22,20">
    <ContentControl x:Name="FeatureHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <Grid x:Name="ConnectionsPage">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Connections" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Kelola host, group, dan pilihan koneksi Anda." Foreground="#91A5BF" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BtnAddHost" Content="＋ Tambah koneksi" Margin="0,0,8,0"/><Button x:Name="BtnRdp" Content="Buka RDP  ↗" Margin="0,0,8,0" ToolTip="Buka Remote Desktop (mstsc) untuk host terpilih yang mendukung RDP"/><Button x:Name="BtnConnect" Content="Buka SSH  ↗" Style="{StaticResource PrimaryButton}" ToolTip="Buka SSH untuk host terpilih yang mendukung SSH"/></StackPanel>
     </Grid>
     <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="SearchBox" ToolTip="Cari koneksi: nama, hostname, user, tag, group (Ctrl+F)" AutomationProperties.Name="Cari koneksi" Margin="0,0,10,0"/>
       <ComboBox x:Name="GroupFilter" Grid.Column="1" ToolTip="Filter group"/>
       <Button x:Name="DetailsToggle" Grid.Column="2" Content="Detail" Margin="10,0,0,0" ToolTip="Tampilkan detail host aktif"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock Text="VPN saat connect" Foreground="#91A5BF" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="VpnOverride" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Layout per tab" Foreground="#91A5BF" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="LayoutCombo" SelectedValuePath="Tag" ToolTip="Jika hanya satu host dipilih, host tersebut dibuka pada seluruh panel layout.">
                        <ComboBoxItem Content="1 panel per tab" Tag="Single"/>
                        <ComboBoxItem Content="Maks. 2 — kiri | kanan" Tag="TwoColumns"/>
                        <ComboBoxItem Content="Maks. 2 — atas / bawah" Tag="TwoRows"/>
                        <ComboBoxItem Content="Maks. 3 — atas 1, bawah 2" Tag="TopOneBottomTwo"/>
                        <ComboBoxItem Content="Maks. 3 — atas 2, bawah 1" Tag="TopTwoBottomOne"/>
                        <ComboBoxItem Content="Maks. 4 — grid 2 × 2" Tag="FourGrid"/>
                    </ComboBox></StackPanel>
       <Button x:Name="BtnTest" Grid.Column="2" Content="Tes koneksi" VerticalAlignment="Bottom"/>
      </Grid>
     </Grid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border CornerRadius="7" BorderBrush="#22354A" BorderThickness="1" Background="#0B1522"><Grid>
       <DataGrid x:Name="HostGrid" AlternationCount="2" IsReadOnly="False">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="Pilih" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Tag="HostSelection" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DataGridRowCheckBox}" ToolTip="Pilih node untuk SSH, SCP, atau editor"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTextColumn Header="★" Binding="{Binding FavoriteMark}" Width="28" IsReadOnly="True" ElementStyle="{StaticResource DataGridRowText}"/>
         <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="1.2*" MinWidth="95" IsReadOnly="True" ElementStyle="{StaticResource DataGridRowText}"/>
         <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="1.15*" MinWidth="95" IsReadOnly="True" ElementStyle="{StaticResource DataGridRowText}"/>
         <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="0.8*" MinWidth="65" IsReadOnly="True" ElementStyle="{StaticResource DataGridRowText}"/>
         <DataGridTemplateColumn Header="Protokol" Width="92" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0"><Border Background="#0F3A63" CornerRadius="3" Padding="5,2" Margin="0,0,4,0" Visibility="{Binding SshVisibility}"><TextBlock Text="SSH" FontSize="10" Foreground="#9CCBFF"/></Border><Border Background="#3B2A63" CornerRadius="3" Padding="5,2" Visibility="{Binding RdpVisibility}"><TextBlock Text="RDP" FontSize="10" Foreground="#D2BDFF"/></Border></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTextColumn Header="Port" Binding="{Binding PortDisplay}" Width="96" IsReadOnly="True" ElementStyle="{StaticResource DataGridRowText}"/>
         <DataGridTemplateColumn Header="Group" Width="0.95*" MinWidth="80" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding GroupBrush}" CornerRadius="4" Padding="7,3" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding GroupLabel}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding GroupLabel}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         <DataGridTemplateColumn Header="Aksi" Width="160" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Tag="RowConnect" Style="{StaticResource PrimaryButton}" Width="32" Height="30" Padding="0" Margin="0,0,5,0" ToolTip="Buka SSH host ini" Visibility="{Binding SshVisibility}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE756;" FontSize="14"/></Button><Button Tag="RowRdp" Width="32" Height="30" Padding="0" Margin="0,0,5,0" ToolTip="Buka RDP host ini" Visibility="{Binding RdpVisibility}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" FontSize="14"/></Button><Button Tag="RowEdit" Width="32" Height="30" Padding="0" Margin="0,0,5,0" ToolTip="Edit host ini"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="14"/></Button><Button Tag="RowMore" Width="32" Height="30" Padding="0" Margin="0,0,5,0" ToolTip="Aksi lainnya"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="14"/></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <StackPanel x:Name="EmptyConnections" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="Belum ada koneksi yang ditampilkan" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Tambahkan koneksi atau ubah pencarian dan filter group." Foreground="#91A5BF" Margin="0,8,0,0"/></StackPanel>
      </Grid></Border>
      <Border x:Name="DetailsPanel" Grid.Column="1" Width="250" Visibility="Collapsed" Style="{StaticResource Card}" Margin="12,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="DetailName" Text="Pilih sebuah host" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailEndpoint" Text="—" Foreground="#6DAEFF" Margin="0,5,0,18" TextWrapping="Wrap"/>

                        <TextBlock Text="PROTOKOL" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="DetailProtocols" Text="—" Margin="0,2,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="GROUP" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="DetailGroup" Text="—" Margin="0,2,0,12"/>
                        <TextBlock Text="AUTENTIKASI" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="DetailAuth" Text="—" Margin="0,2,0,12"/>
                        <TextBlock Text="VPN" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="DetailVpn" Text="—" Margin="0,2,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="TAGS" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="DetailTags" Text="—" Margin="0,2,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="CATATAN" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="DetailNotes" Text="—" Margin="0,2,0,12" TextWrapping="Wrap" MaxHeight="120"/>
                    </StackPanel></ScrollViewer></Border>
     </Grid>
     <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="BtnScp" Content="⇅  SCP Transfer" Margin="0,0,8,0"/><Button x:Name="BtnEditFile" Content="✎  Remote Editor"/></StackPanel></Grid>
     <!-- <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button x:Name="BtnScp" Content="⇅  SCP Transfer" Margin="0,0,8,0"/><Button x:Name="BtnEditFile" Content="✎  Remote Editor"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="BtnEditHost" Content="Edit host" Style="{StaticResource QuietButton}"/><Button x:Name="BtnDuplicateHost" Content="Duplikat" Style="{StaticResource QuietButton}"/><Button x:Name="BtnDeleteHost" Content="Hapus" Foreground="#FF929C" Style="{StaticResource QuietButton}"/></StackPanel>
     </Grid> -->
    </Grid>
    <Grid x:Name="LayoutPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Multi-Host Terminal Layout" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Pilih susunan panel untuk host yang sudah dipilih." Foreground="#91A5BF" Margin="0,5,0,0"/></StackPanel><Button x:Name="LayoutConnectButton" Grid.Column="1" Content="Buka di Windows Terminal  ↗" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"/></Grid>
     <WrapPanel x:Name="LayoutCards" Grid.Row="1" Margin="0,0,0,12"><Button Tag="Single" Style="{StaticResource LayoutCard}"><StackPanel><TextBlock Text="▣" FontSize="27" Foreground="#74ABFF" HorizontalAlignment="Center"/><TextBlock Text="1 panel" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
<Button Tag="TwoColumns" Style="{StaticResource LayoutCard}"><StackPanel><TextBlock Text="▥" FontSize="27" Foreground="#74ABFF" HorizontalAlignment="Center"/><TextBlock Text="2 panel · kiri / kanan" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
<Button Tag="TwoRows" Style="{StaticResource LayoutCard}"><StackPanel><TextBlock Text="▤" FontSize="27" Foreground="#74ABFF" HorizontalAlignment="Center"/><TextBlock Text="2 panel · atas / bawah" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
<Button Tag="TopOneBottomTwo" Style="{StaticResource LayoutCard}"><StackPanel><TextBlock Text="▦" FontSize="27" Foreground="#74ABFF" HorizontalAlignment="Center"/><TextBlock Text="3 panel · 1 + 2" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
<Button Tag="TopTwoBottomOne" Style="{StaticResource LayoutCard}"><StackPanel><TextBlock Text="▦" FontSize="27" Foreground="#74ABFF" HorizontalAlignment="Center"/><TextBlock Text="3 panel · 2 + 1" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
<Button Tag="FourGrid" Style="{StaticResource LayoutCard}"><StackPanel><TextBlock Text="▦" FontSize="27" Foreground="#74ABFF" HorizontalAlignment="Center"/><TextBlock Text="4 panel · grid 2 × 2" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button></WrapPanel>
     <Border Grid.Row="2" Background="#03070C" BorderBrush="#2879DC" BorderThickness="1" CornerRadius="7"><DockPanel><Border DockPanel.Dock="Top" Background="#101E30" BorderBrush="#254568" BorderThickness="0,0,0,1" Padding="15,12"><TextBlock Text="PRATINJAU LAYOUT · Sesi SSH dibuka di Windows Terminal" Foreground="#ADC4E3" FontSize="11"/></Border><Grid x:Name="LayoutPreviewGrid" Margin="5"/></DockPanel></Border>
     <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LayoutSelectionText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#91A5BF" Margin="0,0,12,0"/><Button x:Name="SelectHostsButton" Grid.Column="1" Content="Pilih koneksi"/></Grid>
    </Grid>
    <ContentControl x:Name="RdpPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <Grid x:Name="ScpPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SCP Transfer" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Upload dan download ke banyak node, dengan status setiap transfer." Foreground="#91A5BF" Margin="0,5,0,0"/></StackPanel><Button x:Name="StartNewScpButton" Grid.Column="1" Content="＋ Transfer baru" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"/></Grid>
     <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="ProgressSummaryText" Text="Belum ada transfer pada sesi ini" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Buka Transfer baru untuk memilih node dan file. Status diperbarui otomatis." Foreground="#91A5BF" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="NodeActivityGrid" IsReadOnly="True"><DataGrid.Columns>
      <DataGridTextColumn Header="Node" Binding="{Binding Name}" Width="1.1*" ElementStyle="{StaticResource DataGridRowText}"/>
      <DataGridTemplateColumn Header="Status" Width="165"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,6"><TextBlock Text="{Binding Status}" Foreground="{Binding Color}"/><ProgressBar Height="3" Margin="0,5,0,0" IsIndeterminate="{Binding IsRunning}" Foreground="#1677FF" Background="#14253A"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Sumber" Binding="{Binding Items}" Width="85" ElementStyle="{StaticResource DataGridRowText}"/>
      <DataGridTextColumn Header="Keterangan" Binding="{Binding Message}" Width="2*" ElementStyle="{StaticResource DataGridRowText}"/>
     </DataGrid.Columns></DataGrid></Border>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#0C1929" BorderBrush="#22354A" BorderThickness="0,1,0,0" Padding="16,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Siap." Foreground="#91A5BF" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" ToolTipService.ShowDuration="60000"/><TextBlock x:Name="CountText" Grid.Column="1" Text="0 host" Foreground="#91A5BF"/></Grid></Border>
 </Grid>
</Window>