<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent" Foreground="#E7EEF8">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="RDP Manager" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Kelola dan buka Remote Desktop dari workspace yang sama." Foreground="#91A5BF" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BtnRdpAdd" Content="＋ Tambah RDP" Margin="0,0,8,0"/><Button x:Name="BtnRdpOpen" Content="Buka RDP  ↗" Style="{StaticResource PrimaryButton}" ToolTip="Buka sesi Remote Desktop (mstsc) untuk host yang dicentang"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,10,0"><TextBlock Text="Cari" Foreground="#91A5BF" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="RdpSearchBox" ToolTip="Search RDP: nama, host/IP, user, group, tag" AutomationProperties.Name="Search RDP"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Group" Foreground="#91A5BF" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="RdpGroupFilter" ToolTip="Filter group"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="VPN saat connect" Foreground="#91A5BF" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="RdpVpnOverride" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
   <Button x:Name="BtnRdpTest" Grid.Column="3" Content="Test RDP" VerticalAlignment="Bottom" ToolTip="Tes TCP ke host:port RDP tanpa login"/>
  </Grid>
  <Border Grid.Row="2" CornerRadius="7" BorderBrush="#22354A" BorderThickness="1" Background="#0B1522"><Grid>
   <DataGrid x:Name="RdpGrid" AlternationCount="2" IsReadOnly="False">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="Pilih" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Tag="RdpSelection" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DataGridRowCheckBox}" ToolTip="Pilih host untuk RDP"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="1.3*" MinWidth="110" IsReadOnly="True" ElementStyle="{StaticResource DataGridRowText}"/>
     <DataGridTextColumn Header="Host/IP" Binding="{Binding HostName}" Width="1.1*" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource DataGridRowText}"/>
     <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource DataGridRowText}"/>
     <DataGridTemplateColumn Header="Group" Width="0.9*" MinWidth="80" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding GroupBrush}" CornerRadius="4" Padding="7,3" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding GroupLabel}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding GroupLabel}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Status" Width="1.1*" MinWidth="110" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" ToolTip="{Binding StatusText}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Aksi" Width="125" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Tag="RdpRowConnect" Style="{StaticResource PrimaryButton}" Width="32" Height="30" Padding="0" Margin="0,0,5,0" ToolTip="Connect RDP"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" FontSize="14"/></Button><Button Tag="RdpRowEdit" Width="32" Height="30" Padding="0" Margin="0,0,5,0" ToolTip="Edit host ini"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="14"/></Button><Button Tag="RdpRowMore" Width="32" Height="30" Padding="0" Margin="0,0,5,0" ToolTip="Aksi lainnya"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="14"/></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <StackPanel x:Name="RdpEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="Belum ada host RDP yang ditampilkan" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Klik Tambah RDP, atau aktifkan RDP pada host yang sudah ada melalui Edit host." Foreground="#91A5BF" Margin="0,8,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Button x:Name="BtnRdpSelectAll" Content="Pilih semua" Margin="0,0,8,0"/><Button x:Name="BtnRdpClear" Content="Kosongkan"/></StackPanel>
   <TextBlock x:Name="RdpSelectionText" Grid.Column="1" Text="0 host RDP dipilih" Foreground="#91A5BF" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
  </Grid>
 </Grid>
</UserControl>
