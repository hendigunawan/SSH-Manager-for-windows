<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit file remote — Proper SSH Manager" Width="1040" Height="740" MinWidth="840" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="#0B1220" Foreground="#E5E7EB" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5E7EB"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0F172A"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="CaretBrush" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="#263348"/><Setter Property="BorderBrush" Value="#475569"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E5E7EB"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Edit file remote" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="EndpointText" Margin="0,4,12,0" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="Node" Foreground="#94A3B8" Margin="0,0,0,3"/><ComboBox x:Name="NodeCombo" DisplayMemberPath="Name" ToolTip="Pilih node yang file-nya ingin diedit"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="RemotePathBox" Text="~/" ToolTip="Path file remote yang akan dibuka; simpan selalu memakai file yang sudah dibuka"/>
   <Button x:Name="OpenButton" Grid.Column="1" Content="Buka" Margin="8,0,7,0"/>
   <Button x:Name="BrowseButton" Grid.Column="2" Content="Pilih file..." Margin="0"/>
  </Grid>
  <TextBlock x:Name="CurrentFileText" Grid.Row="2" Text="Belum ada file dibuka. Pilih file teks pada node di atas." Margin="0,0,0,10" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
  <WrapPanel Grid.Row="3" Margin="0,0,0,10">
   <Button x:Name="SaveButton" Content="Simpan (Ctrl+S)" Background="#166534" BorderBrush="#22C55E"/>
   <Button x:Name="ReloadButton" Content="Muat ulang"/>
   <Button x:Name="SaveLocalButton" Content="Simpan salinan lokal..."/>
   <Button x:Name="UndoButton" Content="Undo" ToolTip="Batalkan perubahan teks (Ctrl+Z)"/>
   <Button x:Name="RedoButton" Content="Redo" ToolTip="Ulangi perubahan teks (Ctrl+Y)"/>
   <CheckBox x:Name="WrapBox" Content="Word Wrap" Margin="5,0,0,0"/>
  </WrapPanel>
  <Grid Grid.Row="4" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Cari (Ctrl+F)" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#94A3B8"/>
   <TextBox x:Name="FindBox" Grid.Column="1" ToolTip="Cari teks tanpa membedakan huruf besar dan kecil"/>
   <Button x:Name="FindNextButton" Grid.Column="2" Content="Berikutnya" Margin="8,0,0,0"/>
  </Grid>
  <TextBox x:Name="EditorBox" Grid.Row="5" FontFamily="Consolas" FontSize="14" Padding="12" AcceptsReturn="True" AcceptsTab="True"
           IsUndoEnabled="True" UndoLimit="100" MaxLength="2097152" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsEnabled="False"/>
  <StackPanel Grid.Row="6" Margin="0,10,0,0">
   <WrapPanel VerticalAlignment="Center">
    <TextBlock x:Name="EncodingText" Text="Encoding: —" VerticalAlignment="Center" Margin="0,0,18,0" Foreground="#94A3B8"/>
    <TextBlock Text="Format baris" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#94A3B8"/>
    <ComboBox x:Name="LineEndingCombo" Width="100" Margin="0,0,18,0" ToolTip="LF untuk Linux, CRLF untuk Windows, CR untuk format lama"/>
    <CheckBox x:Name="BackupBox" Content="Buat backup sebelum simpan" IsChecked="True"/>
    <TextBlock x:Name="CaretText" VerticalAlignment="Center" Foreground="#94A3B8"/>
   </WrapPanel>
   <TextBlock x:Name="MixedEndingText" Visibility="Collapsed" Foreground="#FBBF24" Margin="0,7,0,0" TextWrapping="Wrap" Text="Format baris campuran: setelah diedit, semua baris memakai format yang dipilih di atas."/>
  </StackPanel>
  <Border Grid.Row="7" Margin="0,12,0,0" BorderBrush="#263348" BorderThickness="0,1,0,0" Padding="0,10,0,0">
   <TextBlock x:Name="EditorStatus" Text="Siap. Buka file teks UTF-8 atau UTF-16 dengan BOM, maksimal 2 MiB." TextWrapping="Wrap" Foreground="#94A3B8" ToolTipService.ShowDuration="60000"/>
  </Border>
 </Grid>
</Window>
