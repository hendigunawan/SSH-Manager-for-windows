<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       
        Background="#080F19" Foreground="#E7EEF8" FontFamily="Segoe UI">
 <Grid Margin="0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Remote Text Editor" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Buka, edit, dan simpan file teks langsung pada server." Foreground="#91A5BF" Margin="0,5,0,0"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="Server" Foreground="#91A5BF" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="NodeCombo" DisplayMemberPath="Name" ToolTip="Pilih node yang file-nya ingin diedit"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="Path file remote" Foreground="#91A5BF" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="RemotePathBox" Text="~/" ToolTip="Path file yang akan dibuka; simpan selalu memakai file yang sudah dibuka"/></StackPanel>
   <Button x:Name="BrowseButton" Grid.Column="2" Content="Pilih file..." Margin="8,0" VerticalAlignment="Bottom"/>
   <Button x:Name="OpenButton" Grid.Column="3" Content="Buka file" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
  </Grid>
  <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="UndoButton" Content="Undo" ToolTip="Batalkan perubahan (Ctrl+Z)" Margin="0,0,7,0"/>
   <Button x:Name="RedoButton" Grid.Column="1" Content="Redo" ToolTip="Ulangi perubahan (Ctrl+Y)" Margin="0,0,14,0"/>
   <CheckBox x:Name="WrapBox" Grid.Column="2" Content="Word Wrap" Margin="0,0,18,0"/>
   <TextBox x:Name="FindBox" Grid.Column="3" ToolTip="Cari teks (Ctrl+F), tanpa membedakan huruf besar/kecil" AutomationProperties.Name="Cari teks"/>
   <Button x:Name="FindNextButton" Grid.Column="4" Content="Cari berikutnya" Margin="8,0,0,0" ToolTip="F3"/>
  </Grid>
  <Border Grid.Row="3" Background="#14253B" BorderBrush="#29415E" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="13,10"><TextBlock x:Name="CurrentFileText" Text="Belum ada file dibuka · pilih file teks pada server" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/></Border>
  <Border Grid.Row="4" BorderBrush="#29415E" BorderThickness="1" Background="#080F19"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Canvas x:Name="LineNumberGutter" Background="#0C1725" ClipToBounds="True" IsHitTestVisible="False"/>
   <TextBox x:Name="EditorBox" Grid.Column="1" FontFamily="Consolas" FontSize="14" Padding="10,12" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top" BorderThickness="0" Background="#080F19"
            IsUndoEnabled="True" UndoLimit="100" MaxLength="2097152" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsEnabled="False"/>
  </Grid></Border>
  <StackPanel Grid.Row="5" Margin="0,12,0,0"><WrapPanel VerticalAlignment="Center">
   <TextBlock x:Name="EndpointText" VerticalAlignment="Center" Margin="0,0,18,0" Foreground="#6DAEFF" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
   <TextBlock x:Name="EncodingText" Text="Encoding: —" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#91A5BF"/>
   <ComboBox x:Name="LineEndingCombo" Width="82" Margin="0,0,14,0" ToolTip="LF untuk Linux, CRLF untuk Windows, CR untuk format lama"/>
   <TextBlock x:Name="CaretText" VerticalAlignment="Center" Foreground="#91A5BF"/>
  </WrapPanel><TextBlock x:Name="MixedEndingText" Visibility="Collapsed" Foreground="#FBBF24" Margin="0,7,0,0" TextWrapping="Wrap" Text="Format baris campuran: setelah diedit, semua baris memakai format yang dipilih di atas."/></StackPanel>
  <Grid Grid.Row="6" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <CheckBox x:Name="BackupBox" Content="Buat backup sebelum simpan" IsChecked="True"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="SaveButton" Content="Simpan (Ctrl+S)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="ReloadButton" Content="Muat ulang" Margin="0,0,8,0"/><Button x:Name="SaveLocalButton" Content="Salinan lokal..."/></StackPanel>
  </Grid>
  <Border Grid.Row="7" Margin="0,12,0,0" BorderBrush="#22354A" BorderThickness="0,1,0,0" Padding="0,10,0,0"><TextBlock x:Name="EditorStatus" Text="Siap. Buka file teks UTF-8 atau UTF-16 dengan BOM, maksimal 2 MiB." TextWrapping="Wrap" Foreground="#91A5BF" ToolTipService.ShowDuration="60000"/></Border>
 </Grid>
</UserControl>
