<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#080F19" Foreground="#E7EEF8">
 <Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="SCP File Transfer" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Upload atau download file ke node yang dipilih." Foreground="#91A5BF" Margin="0,5,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="230"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.6*" MinWidth="440"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="16"><DockPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="PILIH NODE" FontSize="11" Foreground="#91A5BF" FontWeight="SemiBold"/><TextBlock x:Name="HostNameText" FontSize="16" TextWrapping="Wrap" Margin="0,9,0,10"/><WrapPanel Margin="0,0,0,8"><Button x:Name="SelectAllNodesButton" Content="Pilih semua" Padding="8,6" Margin="0,0,6,0"/><Button x:Name="ClearNodesButton" Content="Kosongkan" Padding="8,6" Margin="0"/></WrapPanel></StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Centang satu atau beberapa node langsung di sini. Path remote dapat diatur per node." TextWrapping="Wrap" Foreground="#91A5BF" FontSize="11" Margin="0,14,0,0"/>
    <ListBox x:Name="NodeList" BorderThickness="0" Background="Transparent" Focusable="False" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><CheckBox Tag="ScpNodeSelection" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Stretch" Padding="0"><StackPanel Margin="0,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding HostName}" Foreground="#91A5BF" FontSize="11" Margin="0,5,0,0"/></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="Transfer files" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <ComboBox x:Name="DirectionCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/>
    <Border x:Name="DropZone" AllowDrop="True" Background="#0A1421" BorderBrush="#3A587A" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,14,0,6"><StackPanel><TextBlock Text="⇅" FontSize="28" HorizontalAlignment="Center" Foreground="#6DAEFF"/><TextBlock x:Name="DropHint" Text="Tarik file atau folder ke sini untuk upload" HorizontalAlignment="Center" Foreground="#B7C7DE" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
    <ItemsControl x:Name="LocalFileList" MaxHeight="110"><ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template><ItemsControl.ItemTemplate><DataTemplate><Border Background="#122238" CornerRadius="3" Margin="0,3" Padding="9,6"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Label x:Name="LocalLabel" Content="Sumber lokal"/><TextBox x:Name="LocalPathBox"/>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="BrowseFileButton" Content="Pilih file..." Margin="0,0,8,0"/><Button x:Name="BrowseFolderButton" Content="Pilih folder..."/></StackPanel>
    <StackPanel x:Name="NodeControls" Margin="0,12,0,0"><Label Content="Atur path remote untuk node"/><ComboBox x:Name="NodeCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
    <TextBlock x:Name="EndpointText" Foreground="#6DAEFF" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <Label x:Name="RemoteLabel" Content="Tujuan remote"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RemotePathBox" ToolTip="Contoh: ~/upload/ atau /var/tmp/file.txt"/><Button x:Name="BrowseRemoteButton" Grid.Column="1" Content="Pilih remote..." Margin="8,0,0,0"/></Grid>
    <Button x:Name="ApplyRemoteAllButton" Content="Terapkan path ke semua node" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Gunakan jika path yang sama tersedia pada semua node. ~/ mengikuti home user setiap node."/>
    <TextBlock x:Name="NodeSummaryText" Foreground="#91A5BF" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"/>
    <StackPanel Margin="0,14,0,0"><CheckBox x:Name="RecursiveBox" Content="Recursive — seluruh isi folder" Margin="0,5"/><CheckBox x:Name="PreserveBox" Content="Pertahankan waktu dan mode file (-p)" Margin="0,5"/><CheckBox x:Name="CompressionBox" Content="Kompresi transfer (-C)" Margin="0,5"/></StackPanel>
    <TextBlock x:Name="DirectionHint" Foreground="#91A5BF" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="11"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Hasil setiap node tersedia pada halaman SCP Transfer." Foreground="#91A5BF" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="Kembali" Margin="0,0,10,0"/><Button x:Name="ActivityButton" Content="Aktivitas" Margin="0,0,10,0"/><Button x:Name="StartButton" Content="Mulai transfer" Style="{StaticResource PrimaryButton}" Padding="22,10"/></StackPanel></Grid>
 </Grid>
</UserControl>
