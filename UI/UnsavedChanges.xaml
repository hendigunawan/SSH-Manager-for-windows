<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perubahan belum disimpan" Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#0B1220" Foreground="#E5E7EB" FontFamily="Segoe UI">
 <Window.Resources><Style TargetType="Button"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="#263348"/><Setter Property="BorderBrush" Value="#475569"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="8,0,0,0"/></Style></Window.Resources>
 <StackPanel Margin="22">
  <TextBlock Text="Simpan perubahan terlebih dahulu?" Foreground="#F8FAFC" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <TextBlock x:Name="UnsavedFileText" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,12,0,20"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="DiscardButton" Content="Buang perubahan"/>
   <Button Content="Batal" IsCancel="True"/>
   <Button x:Name="ConfirmSaveButton" Content="Simpan" IsDefault="True" Background="#166534" BorderBrush="#22C55E"/>
  </StackPanel>
 </StackPanel>
</Window>
